{
  "name": "@adviverse/desktop",
  "version": "0.1.0",
  "description": "Adviverse ads for native desktop apps that host a webview (Electron, Tauri, CEF, WKWebView, WebView2).",
  "license": "UNLICENSED",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./react": { "types": "./dist/react.d.ts", "import": "./dist/react.js" },
    "./electron": { "types": "./dist/electron.d.ts", "import": "./dist/electron.js" }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "react": ">=17",
    "electron": ">=22"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true },
    "electron": { "optional": true }
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/node": "^22.0.0",
    "electron": "^30.0.0",
    "react": "^18.3.0",
    "typescript": "^5.6.2"
  },
  "keywords": ["adviverse", "ads", "desktop", "electron", "tauri", "webview"]
}
